{
  "name": "Cherry",
  "short_name": "Cherry",
  "description": "Recipe videos, turned into a cook mode that loops every step.",
  "id": "/app/",
  "start_url": "/app/?source=pwa",
  "scope": "/app/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#F4EEE4",
  "theme_color": "#F4EEE4",
  "icons": [
    { "src": "/assets/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/assets/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/assets/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "/app/add",
    "method": "GET",
    "params": { "title": "title", "text": "text", "url": "url" }
  },
  "shortcuts": [
    { "name": "Add a recipe", "url": "/app/add", "icons": [{ "src": "/assets/icon-192.png", "sizes": "192x192" }] },
    { "name": "Grocery list", "url": "/app/list", "icons": [{ "src": "/assets/icon-192.png", "sizes": "192x192" }] }
  ]
}
