# ============================================================
# CHERRY BACKEND — FILE UNICO DELLE CHIAVI
# Copia questo file in `.env` e compila i valori.
# Su Render: inserisci le stesse variabili in Environment.
# ============================================================

# --- Firebase (service account del NUOVO progetto) ----------
# Console Firebase → Impostazioni progetto → Account di servizio
# → Genera nuova chiave privata. Incolla qui il JSON su UNA riga
# (oppure usa FIREBASE_SERVICE_ACCOUNT_PATH con il percorso del file).
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH=
# Bucket di Firebase Storage (Console → Storage)
FIREBASE_STORAGE_BUCKET=cherry-662ac.firebasestorage.app
# Progetto GCP di Firestore (Firebase "Cherry"): senza, la dashboard
# legge il progetto sbagliato.
FIREBASE_PROJECT_ID=cherry-662ac
# Nome del database Firestore. Lascia vuoto solo se hai il "(default)";
# se in console il database ha un nome (es. "cherry"), va scritto qui.
FIREBASE_DATABASE_ID=cherry

# --- Google Gemini via Vertex AI ----------------------------
# Chiave Vertex (express mode). Il backend chiama
# aiplatform.googleapis.com, NON generativelanguage.googleapis.com.
GEMINI_API_KEY=
# Modello testo/vision (default se vuoto: gemini-3.8-flash)
GEMINI_MODEL=

# --- fal.ai — foto ricette, FLUX.1 [schnell] (fal.ai) --------
FAL_KEY=

# --- RapidAPI — download video TikTok/Instagram --------------
# rapidapi.com → "Social Download All In One" → subscribe
RAPIDAPI_KEY=

# --- Superwall (superwall.com) — OPZIONALE -------------------
# Serve solo al webhook: Superwall notifica rinnovi, scadenze e
# rimborsi, e il backend aggiorna users/{uid}.subscription su
# Firestore. Senza, l'acquisto funziona lo stesso ma lo stato
# abbonamento lato server non si aggiorna da solo.
# La public key dell'SDK sta invece in app/Cherry/Config/Secrets.swift.
SUPERWALL_WEBHOOK_SECRET=

# --- APNs — Live Activity condivise (OPZIONALE) --------------
# Serve a una cosa sola: quando una persona spunta un articolo, la
# Live Activity dell'altra si aggiorna anche a telefono bloccato.
# Senza queste chiavi tutto il resto funziona: la lista resta live in
# app, ma la lock screen dell'altra persona aspetta la riapertura.
#
# developer.apple.com → Certificates, Identifiers & Profiles → Keys
# → "+" → spunta "Apple Push Notifications service (APNs)" → scarica
# il .p8 UNA volta sola (non è più riscaricabile).
# APNS_KEY_ID: i 10 caratteri nel nome del file AuthKey_XXXXXXXXXX.p8
# APNS_TEAM_ID: in alto a destra nel portale (stesso account: 7ZST47J92X)
# APNS_KEY_P8: contenuto del .p8 su una riga, con \n al posto degli a capo
#              (serve su Render, dove non c'è un filesystem locale:
#               ricavalo con  awk '{printf "%s\\n", $0}' AuthKey_XXX.p8)
# APNS_KEY_PATH: in locale è più comodo — percorso del file, anche
#                relativo alla cartella backend/
APNS_KEY_ID=
APNS_TEAM_ID=7ZST47J92X
APNS_KEY_P8=
APNS_KEY_PATH=secrets/AuthKey_XXXXXXXXXX.p8
APNS_BUNDLE_ID=com.cherry.jacopogiannetti.app
# Ambiente preferito: true = TestFlight/App Store, false = build da
# Xcode. Se il token appartiene all'altro ambiente il server ritenta da
# solo, quindi sbagliarlo non rompe niente.
APNS_PRODUCTION=true

# Per verificare la configurazione senza telefono: npm run check:apns

# --- Sicurezza app <-> backend -------------------------------
# Generane uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Lo stesso valore va in app/Cherry/Config/Secrets.swift (hmacSecret)
HMAC_SECRET=

# --- AppsFlyer (opzionale) ------------------------------------
# L'app le pesca da GET /config. Vuote = SDK spento. Quando hai
# l'account: dashboard AppsFlyer → App Settings → Dev Key, e il
# numero App Store Connect (senza il prefisso "id"). Su Render
# basta aggiungerle e riavviare: niente update dell'app.
APPSFLYER_DEV_KEY=
APPLE_APP_ID=6822337167

# --- Open Food Facts (nessuna chiave, solo identificazione) --
OFF_USER_AGENT=Cherry/1.0

# --- Ricettario condiviso -------------------------------------
# true = i mazzi escono dal ricettario (classifica + piatti dell'atlante).
# Vuoto o false = flusso di prima, una chiamata IA per tutto il mazzo.
CATALOG_ENABLED=
# Il passaggio ogni 15 minuti che chiude i voti delle run abbandonate.
# Con due server sullo stesso database, false su uno dei due.
CATALOG_SWEEP=
# Modello del critico; vuoto = lo stesso di GEMINI_MODEL.
CATALOG_CRITIC_MODEL=

# --- Server ---------------------------------------------------
PORT=3000
# Limite giornaliero di lavori AI per utente
DAILY_JOB_LIMIT=100
# Limite giornaliero di immagini generate per utente
DAILY_IMAGE_LIMIT=60
