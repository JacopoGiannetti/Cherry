rules_version = '2';

// Regola di fondo: l'utente legge e scrive SOLO il proprio albero.
// Il backend usa l'Admin SDK e bypassa queste regole, quindi le cache
// globali e i contatori restano invisibili e intoccabili dai client.
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      // Il client può aggiornare il proprio profilo ma NON lo stato
      // abbonamento né i contatori quota (li scrive solo il backend).
      allow create: if request.auth != null && request.auth.uid == uid
        && !request.resource.data.keys().hasAny(['subscription', 'stripe', 'dailyUsage', 'usage']);
      allow update: if request.auth != null && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['subscription', 'stripe', 'dailyUsage', 'usage']);

      // Serie giornaliera dei costi: solo backend.
      match /usageDays/{day} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }

      match /{collection}/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == uid
          && collection != 'usageDays';

        match /{sub}/{subId} {
          allow read, write: if request.auth != null && request.auth.uid == uid;
        }
      }
    }

    // Spazi condivisi: due persone, le stesse liste della spesa.
    // Il documento dello spazio (membri, codice invito) lo scrive solo
    // il backend; i membri lo leggono e basta. Le liste dentro, invece,
    // si modificano dall'app come quelle personali: spuntare la spesa
    // deve funzionare anche senza rete.
    match /spaces/{spaceId} {
      // Sul documento stesso basta resource.data: niente get() extra,
      // e la query "i miei spazi" resta una sola lettura.
      allow read: if request.auth != null
        && request.auth.uid in resource.data.memberUids;
      allow write: if false;

      match /{collection}/{docId} {
        allow read, write: if isSpaceMember(spaceId);

        match /{sub}/{subId} {
          allow read, write: if isSpaceMember(spaceId);
        }
      }
    }

    // Liste della spesa condivise per link: chi conosce l'id (16 caratteri casuali)
    // la legge e la spunta anche senza account. Nessuno può elencarle; solo chi
    // l'ha creata la crea o la cancella, e nessuno può cambiarne il proprietario.
    match /sharedLists/{listId} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && validSharedList(request.resource.data);
      allow update: if validSharedList(request.resource.data)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['items', 'recipeIds', 'recipes', 'updatedAt', 'ownerName']);
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }

    function validSharedList(d) {
      return d.keys().hasOnly(['items', 'recipeIds', 'recipes', 'updatedAt', 'createdAt', 'ownerUid', 'ownerName'])
        && d.items is list && d.items.size() <= 400
        && (!('recipeIds' in d) || (d.recipeIds is list && d.recipeIds.size() <= 60))
        && (!('recipes' in d) || (d.recipes is list && d.recipes.size() <= 60));
    }

    // Codici di invito: risolti solo dal backend, altrimenti sarebbero
    // indovinabili a tentativi.
    match /inviteCodes/{code} {
      allow read, write: if false;
    }

    function isSpaceMember(spaceId) {
      return request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/spaces/$(spaceId)).data.memberUids;
    }

    // Cache globali: solo backend (Admin SDK). Nessun accesso client.
    match /caches/{document=**} {
      allow read, write: if false;
    }

    // Totali di prodotto: solo backend.
    match /analytics/{document=**} {
      allow read, write: if false;
    }
  }
}
