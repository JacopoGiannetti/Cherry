{
  "name": "cherry-backend",
  "version": "1.0.0",
  "description": "Cherry backend — fire-and-forget jobs, writes to Firestore",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "check:firebase": "node scripts/check-firebase.js",
    "check:ai": "node scripts/check-ai.js",
    "check:apns": "node scripts/check-apns.js",
    "deploy:rules": "node scripts/deploy-rules.js",
